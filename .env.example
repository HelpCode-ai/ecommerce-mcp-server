# Copied to .env by scripts/install.sh, which also fills the secrets.
# Keep .env: ENCRYPTION_KEY decrypts every credential AnythingMCP stores.
JWT_SECRET=
ENCRYPTION_KEY=

# First admin account, created by scripts/install.sh.
AMCP_ADMIN_EMAIL=
AMCP_ADMIN_PASSWORD=

# Amazon Seller Central (SP-API): fill these and re-run scripts/install.sh to install the connector.
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_ENDPOINT=
SPAPI_MARKETPLACE_ID=
SPAPI_SELLER_ID=

# WooCommerce: fill these and re-run scripts/install.sh to install the connector.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Shopware 6 Store API: fill these and re-run scripts/install.sh to install the connector.
SHOPWARE_URL=
SHOPWARE_ACCESS_KEY=

# Magento (Adobe Commerce): fill these and re-run scripts/install.sh to install the connector.
MAGENTO_BASE_URL=
MAGENTO_ACCESS_TOKEN=

# BigCommerce: fill these and re-run scripts/install.sh to install the connector.
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_ACCESS_TOKEN=

# eBay Sell: fill these and re-run scripts/install.sh to install the connector.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=

# Etsy: fill these and re-run scripts/install.sh to install the connector.
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=

# Ecwid: fill these and re-run scripts/install.sh to install the connector.
ECWID_STORE_ID=
ECWID_TOKEN=

# Kaufland Marketplace: fill these and re-run scripts/install.sh to install the connector.
KAUFLAND_CLIENT_KEY=
KAUFLAND_SECRET_KEY=

# OTTO Market: fill these and re-run scripts/install.sh to install the connector.
OTTO_USERNAME=
OTTO_PASSWORD=

# Zalando Partner (ZDS): fill these and re-run scripts/install.sh to install the connector.
ZALANDO_CLIENT_ID=
ZALANDO_CLIENT_SECRET=
ZALANDO_MERCHANT_ID=

# Billbee Order Management: fill these and re-run scripts/install.sh to install the connector.
